# Aetheris — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── NASA DONKI API (free key from https://api.nasa.gov/) ──────────────────────
# DEMO_KEY works for low volume dev; register for 1000 req/hr in production
NASA_API_KEY=DEMO_KEY

# ── Gemini 1.5 Flash (free tier: 15 RPM, 1M tokens/day) ─────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Cloudflare (set via wrangler secrets for Worker; set as repo secrets for CI) ──
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_PAGES_PROJECT_NAME=aetheris

# ── Cloudflare KV Namespace IDs (from wrangler.toml) ─────────────────────────
# Replace placeholder in wrangler.toml with real ID after `wrangler kv:namespace create CACHE`
CF_KV_NAMESPACE_ID=

# ── Beta Access ───────────────────────────────────────────────────────────────
# Comma-separated hashed invite codes for first beta cohort
BETA_INVITE_CODES=
