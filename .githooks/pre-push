#!/bin/sh
# ==============================================================================
# Pre-push Verification Hook (Vishwa-Vani Style)
# ==============================================================================

echo "================================================="
echo "Pre-push Verification Hook"
echo "================================================="

# In Windows local environments where native tools/runtimes or packages may differ from CI,
# execute npm run lint / tsc to verify syntax & type safety.
if [ -f package.json ]; then
    if [ -f node_modules/.bin/eslint ] || [ -f node_modules/.bin/eslint.cmd ]; then
        echo "Running eslint..."
        if ! npx eslint . --max-warnings 10; then
            echo "Lint verification failed! Please fix the errors before pushing."
            exit 1
        fi
    fi
    if [ -f node_modules/.bin/tsc ] || [ -f node_modules/.bin/tsc.cmd ]; then
        echo "Running tsc --noEmit..."
        if ! npx tsc --noEmit; then
            echo "TypeScript verification failed! Please fix the errors before pushing."
            exit 1
        fi
    fi
fi

echo "Pre-push verification checks passed! Safe to push to CI/CD."
exit 0