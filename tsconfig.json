{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "types": ["node"]
  },
  "include": ["lib/**/*", "tests/**/*", "script/**/*", "functions/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
