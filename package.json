{
  "name": "aetheris",
  "version": "0.1.10",
  "description": "Temporal Intelligence & Environmental Sentinel — zero-cost PWA on Cloudflare edge",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npx tsx script/test.js",
    "test:e2e": "playwright test",
    "status": "npx tsx script/status.js",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "worker:dev": "npx wrangler dev --local",
    "worker:deploy": "npx wrangler deploy",
    "ingest": "npx tsx script/ingest.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "wrangler": "^4.95.0"
  },
  "keywords": [
    "temporal-intelligence",
    "cloudflare-workers",
    "news-deduplication",
    "space-weather",
    "pwa"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "mapbox-gl": "^3.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.1.1"
  }
}
