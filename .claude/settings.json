{
  "respectGitignore": true,
  "autoCompactWindow": 40000,
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  },
  "enabledSkills": {
    "caveman": true,
    "engineering": true,
    "product": true,
    "vite-react": true,
    "cloudflare-workers": true,
    "mapbox-gl": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.prompt // .prompt // \"\"' 2>/dev/null | grep -q 'SPRINT:backlog-sprint' && echo '{\"systemMessage\": \"Sprint detected — if context window is large, cancel and run /compact first, then re-invoke /backlog-sprint for best results.\"}' || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
